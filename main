/***************************************************************************************************
 * Main.cpp file. It instantiates a list object and executes a required sequence of operations to 
 * verify the functionality of the list. Such as adding items, printing the 
 * list, checking its size and empty status, removing a specific node, finding 
 * the position of specific data, and clearing the list entirely.
 *
 * Author: Vini Dargas
 * Version: 07/04/2026
 **************************************************************************************************/

#include "DoubleLinkedList.h"
#include <iostream>

int main(){
    DoubleLinkedList myList;

    myList.addNode(1);
    myList.addNode(5);
    myList.addNode(9);
    myList.addNode(16);
    myList.addNode(25);
    myList.addNode(2);
    myList.addNode(7);
    myList.addNode(19);
    
    myList.printList();
    std::cout << "\n";
    
    myList.addNode(10);
    
    myList.printList();
    std::cout << "\n";
    
    std::cout << "Number of items in the list is: " << myList.getSize() << "\n";
    
    if (myList.isEmpty()) {
        std::cout << "List is empty" << "\n";
    } else {
        std::cout << "List is not empty" << "\n";
    }
    
    myList.removeNode(9);
    
    myList.printList();
    std::cout << "\n";
    
    std::cout << "Number of items in the list is: " << myList.getSize() << "\n";

    int numberToFind = 16; //This conditional allows to find any number instead of unique cases
    int position = myList.findNode(numberToFind);
    if(position != -1){ 
        std::cout << "Number " << numberToFind << " is located at position " << position << "\n";
    } else {
        std::cout << "Number " << numberToFind << " is not in the list \n";
    }

    numberToFind = 9; // new number assigned to find its position 
    position = myList.findNode(numberToFind);
    if(position != -1){ 
        std::cout << "Number " << numberToFind << " is located at position " << position << "\n";
    } else {
        std::cout << "Number " << numberToFind << " is not in the list\n";
    }

    myList.clear();//clear the list
    
    if (myList.isEmpty()) {
        std::cout << "List is empty" << "\n";
    } else {
        std::cout << "List is not empty" << "\n";
    }

    return 0;
}
